# Base URL of a local Ollama server. No API key is used.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Model to pull and chat with. It should support tool calling (llama3.2 does).
OLLAMA_MODEL=llama3.2

# Folder the tools are allowed to see. Paths the model passes are relative to this.
WORKSPACE_ROOT=./demo-files

# Optional. "true" exposes run_shell, limited to /bin/date and /bin/echo.
# Leave false unless you are demonstrating the allowlist. See the README.
ENABLE_SHELL=false

# Optional. Maximum bytes read_file returns to the model.
MAX_READ_BYTES=32768
